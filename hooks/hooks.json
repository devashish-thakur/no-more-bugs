{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/using-no-more-bugs/scripts/nmb.mjs\" hook session-start", "timeout": 60 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/using-no-more-bugs/scripts/nmb.mjs\" hook user-prompt-submit", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/using-no-more-bugs/scripts/nmb.mjs\" hook pre-tool-use", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/using-no-more-bugs/scripts/nmb.mjs\" hook stop", "timeout": 120 }
        ]
      }
    ]
  }
}
